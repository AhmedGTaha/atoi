# Copy this file to .env and fill in real values.
# Never commit a filled-in .env file.

# --- Database ---------------------------------------------------------
# PostgreSQL connection string. Works with Neon, Vercel Postgres, Supabase,
# Railway, or any managed Postgres reachable from Vercel.
DATABASE_URL="postgresql://user:password@host:5432/atoi"

# --- Application --------------------------------------------------------
# Public base URL of the deployed app (no trailing slash).
# Used to build links inside transactional emails.
APP_URL="http://localhost:3000"

# Secret used to sign session cookies and password-reset/invite tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# --- Resend (transactional email) ---------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Atrio <hello@yourdomain.com>"

# --- Persistent file storage (Vercel Blob) -------------------------------
# Created automatically when you add a Blob store to your Vercel project,
# or via `vercel blob store add` / the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""

# --- Initial admin seed ---------------------------------------------------
# Used once by `npm run db:seed` to create the first AdminUser if none exists.
# Change the password immediately after first login.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-me-immediately"
